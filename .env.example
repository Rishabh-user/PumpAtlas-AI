# PumpAtlas AI - configuration reference. Copy to `.env` and change what you need;
# every value shown is the code default, so a line you leave alone can be deleted.
#
# Not here, because neither is configuration:
#   * the login - `python -m scripts.manage_user create --email you@example.com --name "You" --platform-admin`
#   * AI provider keys - stored encrypted and chosen on the /ai-settings page

# ---------- Core ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PROJECT_NAME=PumpAtlas AI

# ---------- Security ----------
# Signs tokens and derives the key that encrypts stored AI credentials: changing it logs
# everyone out and orphans those keys. Commented out here so the dev default applies and
# /api/v1/ready flags it; setting it to nothing is refused at startup.
#   openssl rand -hex 32
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000

# ---------- PostgreSQL (system of record) ----------
# Connect as the application role, never the owner: owning the tables or holding
# BYPASSRLS disables every tenant isolation policy silently.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pumpatlas
POSTGRES_USER=pumpatlas
POSTGRES_PASSWORD=
# `prefer` accepts an unencrypted connection without saying so. Use `require` for any
# managed provider, or anything off-host.
POSTGRES_SSLMODE=prefer
# Optional; overrides the six keys above.
# DATABASE_URL=postgresql+psycopg://pumpatlas:pumpatlas@postgres:5432/pumpatlas

# Pool and timeouts. Worth tuning against a hosted database, where a round trip is
# ~300ms and too small a pool turns concurrency into queueing.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=15
DB_STATEMENT_TIMEOUT=30s
DB_ECHO=false

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Runs background jobs inside the request instead of queueing them, so a discovery run
# holds the HTTP call open for minutes. Development only; refused in production.
CELERY_TASK_ALWAYS_EAGER=false

# ---------- Object storage (S3 compatible) ----------
# Setting S3_ACCESS_KEY *and* S3_SECRET_KEY is what selects the S3 backend. Left empty,
# documents go to LOCAL_STORAGE_DIR, which is correct when no object store is running.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=pumpatlas-documents
S3_USE_SSL=false
LOCAL_STORAGE_DIR=./.data/documents

# ---------- AI ----------
# The active rows in `ai_provider_configs` decide what runs, set at /ai-settings. This
# whole section is a fallback for an installation that has not configured that page.
# Reading a page: openrouter | openai | anthropic
EXTRACTION_PROVIDER=openrouter
# Finding pages: parallel | openai | anthropic
SEARCH_PROVIDER=parallel
AI_ENABLED=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_INPUT_CHARS=200000

# Gemma via OpenRouter. Reading only - it cannot search.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it
OPENROUTER_FALLBACK_MODEL=google/gemma-3-12b-it
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=3
# Longer pages are truncated before sending, and the prompt says so.
OPENROUTER_MAX_INPUT_CHARS=60000

# Parallel AI. Search only, and the only provider that returns page text rather than a
# bare link - which is what extraction and chat citations have to quote.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_TIMEOUT_SECONDS=180
PARALLEL_MAX_RESULTS=15
SEARCH_MAX_USES=5

# ---------- Ingestion ----------
MAX_UPLOAD_MB=50
CRAWL_USER_AGENT=PumpAtlasAI/1.0 (+https://targeticon.com/pumpatlas)
CRAWL_RESPECT_ROBOTS=true
CRAWL_MAX_PAGE_BYTES=10485760
